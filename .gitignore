# Most archives are repeated intermediate submissions. Keep only the source
# packages and the final independently reproducible submission listed below.
**/*.zip
!/warmup1_starter.zip
!/result.zip
!formal_track1/downloads/baseline.zip
!formal_track1/downloads/track1_data.zip
!formal_track1/result_v69_d1v65_1200_d2v62_local.zip

# The canonical warm-up dataset is kept once.
**/*.pkl
!data/cora.pkl

# Generated PDF QA files are local-only; the verified DOCX is committed.
*.pdf
